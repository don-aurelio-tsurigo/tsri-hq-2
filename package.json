{
  "name": "neuesverwaltungstool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && NODE_OPTIONS=--max-old-space-size=4096 next build --webpack",
    "start": "tsx scripts/migrate-deploy.ts && MALLOC_ARENA_MAX=2 next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "tsx scripts/migrate-deploy.ts",
    "db:push": "node scripts/db-push.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:check-pgvector": "tsx scripts/check-pgvector.ts",
    "db:import-rag": "tsx scripts/import-rag-from-staging.ts",
    "rag:sync": "tsx scripts/rag-sync.ts",
    "dam:purge": "tsx scripts/dam-purge.ts",
    "dam:delete-collections": "tsx scripts/dam-delete-collections.ts",
    "dam:mediagraph-import": "tsx scripts/mediagraph-import.ts",
    "dam:mediagraph-enrich": "tsx scripts/mediagraph-import.ts --enrich",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@better-auth/prisma-adapter": "^1.6.25",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "better-auth": "^1.6.25",
    "date-fns": "^4.4.0",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.9",
    "next": "16.3.1",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^20.1.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
