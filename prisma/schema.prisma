generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // multiSchema: HQ models stay in public; RAG tables live in schema "rag"
  schemas  = ["public", "rag"]
}

// ─── Better Auth ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  /// Display name, kept in sync as "firstName lastName" for Better Auth.
  name          String
  firstName     String?
  lastName      String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  birthDate     DateTime? @db.Date
  /// Freie Notizen fürs private Home-Dashboard
  privateNotes  String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions              Session[]
  accounts              Account[]
  memberships           Membership[]
  ownedSpaces           Space[]              @relation("SpaceOwner")
  spaceAccess           SpaceAccess[]
  createdTasks          Task[]               @relation("TaskCreator")
  assignedTasks         Task[]               @relation("TaskAssignee")
  createdArticles       Article[]            @relation("ArticleCreator")
  assignedArticles      Article[]            @relation("ArticleAssignee")
  createdChores         Chore[]              @relation("ChoreCreator")
  choreAssignments      ChoreAssignment[]
  cookingSlots          CookingSlot[]
  cookingAssignments    CookingSlot[]        @relation("CookingSlotAssigner")
  invitationsSent       Invitation[]         @relation("InvitationInviter")
  passwordResets        PasswordResetToken[] @relation("PasswordResetTarget")
  passwordResetsCreated PasswordResetToken[] @relation("PasswordResetCreator")
  authoredNewsletters   NewsletterCampaign[] @relation("NewsletterAuthor")
  createdNewsletters    NewsletterCampaign[] @relation("NewsletterCreator")
  vacationRequests      VacationRequest[]    @relation("VacationRequester")
  vacationReviews       VacationRequest[]    @relation("VacationReviewer")
  timeEntries           TimeEntry[]
  createdWikiPages      WikiPage[]           @relation("WikiPageCreator")
  updatedWikiPages      WikiPage[]           @relation("WikiPageUpdater")
  createdCarouselPosts  CarouselPost[]       @relation("CarouselPostCreator")
  usageEvents           MemberUsage[]
  uploadBatches         UploadBatch[]
  assets                Asset[]
  deletedAssets         Asset[]              @relation("AssetDeletedBy")
  collections           Collection[]
  exportLogs            ExportLog[]
  damArchiveReviews     DamArchiveReview[]
  taskInboxPins         TaskInboxPin[]

  @@map("user")
  @@schema("public")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
  @@schema("public")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
  @@schema("public")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("public")
}

// ─── Organisation & Membership ─────────────────────────────────

enum MembershipRole {
  admin
  member

  @@schema("public")
}

/// Tags on a membership: access (Finance) and groups (Redaktion, Civic Media).
/// Admin implies access tags only, not group tags (rosters/filters).
enum AppCapability {
  finance
  editorial
  editorial_lead
  civic_media
  civic_media_lead

  @@schema("public")
}

model Organization {
  id                            String   @id @default(cuid())
  name                          String
  slug                          String   @unique
  /// Newsletter-Slots an Feiertagen ausblenden (ZH/CH)
  hideNewsletterHolidays        Boolean  @default(false)
  /// Slack: wöchentlicher Kochplan-Digest (Montag)
  slackCookingWeeklyEnabled     Boolean  @default(false)
  /// Incoming Webhook URL for weekly digest (overrides SLACK_WEBHOOK_URL)
  slackCookingWeeklyWebhookUrl  String?
  /// Slack: monatlicher Eintrag-Reminder (letzte Monatswoche)
  slackCookingMonthlyEnabled    Boolean  @default(false)
  /// Incoming Webhook URL for monthly reminder (overrides SLACK_WEBHOOK_URL)
  slackCookingMonthlyWebhookUrl String?
  /// Dedup-Key letzte Wochen-Nachricht, z.B. 2026-W32
  slackCookingWeeklyLastKey     String?
  /// Dedup-Key letzte Monats-Nachricht, z.B. 2026-09 (Folgemonat)
  slackCookingMonthlyLastKey    String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  memberships             Membership[]
  invitations             Invitation[]
  spaces                  Space[]
  newsletterTypes         NewsletterType[]
  newsletterBlockedRanges NewsletterBlockedRange[]
  vacationRequests        VacationRequest[]
  timeEntries             TimeEntry[]
  eigenleistungRubriken   EigenleistungRubrik[]
  articleCategories       ArticleCategory[]
  wikiPages               WikiPage[]
  newsItems               NewsItem[]
  payrexxPayouts          PayrexxPayout[]
  payrexxChannelRules     PayrexxChannelRule[]

  @@map("organization")
  @@schema("public")
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(member)
  /// Anstellungsgrad in Prozent (100 = Vollzeit, Bezug: 40h/Woche)
  pensumPercent  Int            @default(100)
  /// Soft-archive: kein App-Zugang, Historie bleibt
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  grants       MembershipGrant[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, archivedAt])
  @@map("membership")
  @@schema("public")
}

model MembershipGrant {
  id           String        @id @default(cuid())
  membershipId String
  capability   AppCapability
  createdAt    DateTime      @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, capability])
  @@map("membership_grant")
  @@schema("public")
}

model Invitation {
  id             String         @id @default(cuid())
  email          String
  organizationId String
  role           MembershipRole @default(member)
  token          String         @unique @default(cuid())
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@map("invitation")
  @@schema("public")
}

/// Einmaliger Passwort-Reset-Link (von Admins erzeugt, manuell teilbar)
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  user      User @relation("PasswordResetTarget", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("PasswordResetCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
  @@schema("public")
}

// ─── Spaces ────────────────────────────────────────────────────

enum SpaceType {
  personal
  team
  project

  @@schema("public")
}

enum SpaceVisibility {
  private
  team
  restricted

  @@schema("public")
}

enum SpacePermission {
  view
  edit
  admin

  @@schema("public")
}

model Space {
  id             String          @id @default(cuid())
  organizationId String
  type           SpaceType
  name           String
  slug           String
  description    String?
  visibility     SpaceVisibility @default(team)
  ownerUserId    String?
  /// Soft-archive for projects (hidden from active list)
  archivedAt     DateTime?
  /// Template project: used to spawn new projects with fixed todos
  isTemplate     Boolean         @default(false)
  /// Event / Durchführungstag (projects only)
  eventAt        DateTime?       @db.Date
  /// Ort / Venue (projects only)
  venue          String?
  /// Pin this project in the app sidebar
  navPinned      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?         @relation("SpaceOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  access       SpaceAccess[]
  tasks        Task[]
  articles     Article[]
  chores       Chore[]
  taskGroups   TaskGroup[]
  cookingSlots CookingSlot[]
  wikiPages    WikiPage[]

  @@unique([organizationId, slug])
  @@index([ownerUserId])
  @@index([organizationId, type])
  @@index([organizationId, type, archivedAt])
  @@index([organizationId, type, isTemplate])
  @@index([organizationId, type, navPinned])
  @@map("space")
  @@schema("public")
}

model SpaceAccess {
  id         String          @id @default(cuid())
  spaceId    String
  userId     String
  permission SpacePermission @default(view)
  createdAt  DateTime        @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@map("space_access")
  @@schema("public")
}

// ─── Tasks / Articles / Chores ─────────────────────────────────

enum TaskStatus {
  todo
  doing
  done
  cancelled

  @@schema("public")
}

enum ArticleStage {
  input
  weiter
  warteliste
  abgelehnt
  in_arbeit
  bereit
  publiziert

  @@schema("public")
}

/// Redaktions-Kategorien (admin-verwaltbar, org-weit)
model ArticleCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// CSS-Farbe z.B. #d4edc0
  color          String   @default("#e5e7eb")
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  articles     Article[]

  @@unique([organizationId, name])
  @@index([organizationId, sortOrder])
  @@map("article_category")
  @@schema("public")
}

/// Eigenleistungs-Rubriken (admin-verwaltbar, org-weit)
model EigenleistungRubrik {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// CSS-Farbe z.B. #ede9fe
  color          String   @default("#e5e7eb")
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  articles     Article[]

  @@unique([organizationId, name])
  @@index([organizationId, sortOrder])
  @@map("eigenleistung_rubrik")
  @@schema("public")
}

/// Generic / project tasks (Inbox, personal lists, project todos)
model Task {
  id            String     @id @default(cuid())
  spaceId       String
  title         String
  description   String?    @db.Text
  status        TaskStatus @default(todo)
  assigneeId    String?
  createdById   String
  groupId       String?
  dueAt         DateTime?
  /// Tage relativ zu Space.eventAt (negativ = vorher). Vorlagen + Spawn.
  dueOffsetDays Int?
  sortOrder     Int        @default(0)
  /// Soft-delete; null = sichtbar in Listen
  archivedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  space     Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  group     TaskGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  assignee  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([spaceId, status])
  @@index([spaceId, groupId])
  @@index([spaceId, archivedAt])
  @@index([assigneeId])
  @@index([createdById])
  @@map("task")
  @@schema("public")
}

/// Editorial articles (Kanban / Redaktionsprogramm)
model Article {
  id                    String       @id @default(cuid())
  spaceId               String
  title                 String
  /// Pitch-Notizen / Artikelinhalt
  description           String?      @db.Text
  stage                 ArticleStage @default(input)
  categoryId            String?
  eigenleistungRubrikId String?
  /// Zuständige Person
  assigneeId            String?
  createdById           String
  /// Geplanter Publikationstag (Redaktionsprogramm)
  publishAt             DateTime?    @db.Date
  /// Soft-archive: ausgeblendet aus aktiven Kanban-/Programm-Ansichten
  archivedAt            DateTime?
  sortOrder             Int          @default(0)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  space               Space                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  assignee            User?                @relation("ArticleAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy           User                 @relation("ArticleCreator", fields: [createdById], references: [id], onDelete: Cascade)
  category            ArticleCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  eigenleistungRubrik EigenleistungRubrik? @relation(fields: [eigenleistungRubrikId], references: [id], onDelete: SetNull)

  @@index([spaceId, stage])
  @@index([spaceId, publishAt])
  @@index([spaceId, archivedAt])
  @@index([assigneeId])
  @@index([createdById])
  @@index([categoryId])
  @@index([eigenleistungRubrikId])
  @@map("article")
  @@schema("public")
}

/// User-defined groups/lists for tasks within a space (personal tasks)
model TaskGroup {
  id        String   @id @default(cuid())
  spaceId   String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space  Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tasks  Task[]
  chores Chore[]

  @@index([spaceId, sortOrder])
  @@map("task_group")
  @@schema("public")
}

enum TaskInboxPinKind {
  list
  project

  @@schema("public")
}

/// Per-user pins for Meine Tasks sidebar (personal lists or project task buckets)
model TaskInboxPin {
  id        String           @id @default(cuid())
  userId    String
  kind      TaskInboxPinKind
  targetId  String
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetId])
  @@index([userId])
  @@map("task_inbox_pin")
  @@schema("public")
}

/// Ämtli / chores with multi-assignee
model Chore {
  id          String     @id @default(cuid())
  spaceId     String
  title       String
  description String?    @db.Text
  status      TaskStatus @default(todo)
  groupId     String?
  createdById String
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  space       Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  group       TaskGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy   User              @relation("ChoreCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignments ChoreAssignment[]

  @@index([spaceId, status])
  @@index([spaceId, groupId])
  @@index([createdById])
  @@map("chore")
  @@schema("public")
}

/// Multi-assignee for chores
model ChoreAssignment {
  id        String   @id @default(cuid())
  choreId   String
  userId    String
  createdAt DateTime @default(now())

  chore Chore @relation(fields: [choreId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([choreId, userId])
  @@index([userId])
  @@map("chore_assignment")
  @@schema("public")
}

/// Kochplan: ein Slot pro Tag (Di–Fr)
model CookingSlot {
  id           String   @id @default(cuid())
  spaceId      String
  date         DateTime @db.Date
  userId       String
  /// Wer die Person eingetragen hat (für „von … eingetragen“)
  assignedById String?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  space      Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("CookingSlotAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([spaceId, date])
  @@index([userId])
  @@index([assignedById])
  @@index([spaceId, date])
  @@map("cooking_slot")
  @@schema("public")
}

// ─── Newsletter Kampagnen ──────────────────────────────────────

enum NewsletterFrequency {
  daily
  weekly

  @@schema("public")
}

/// Geplant / erschienen / ausgefallen (z.B. Sommerpause)
enum NewsletterCampaignStatus {
  planned
  published
  skipped

  @@schema("public")
}

model NewsletterType {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  frequency      NewsletterFrequency
  /// ISO-Wochentage: 1=Montag … 7=Sonntag
  weekdays       Int[]               @default([])
  /// Wordle-Feld in der Planung anzeigen und beim Speichern verlangen
  requiresWordle Boolean             @default(false)
  sortOrder      Int                 @default(0)
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization  Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns     NewsletterCampaign[]
  blockedRanges NewsletterBlockedRange[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("newsletter_type")
  @@schema("public")
}

/// Sommerpause / geblockte Zeiträume — pro Newsletter-Typ, keine Slots im Kalender
model NewsletterBlockedRange {
  id               String   @id @default(cuid())
  organizationId   String
  newsletterTypeId String
  startDate        DateTime @db.Date
  endDate          DateTime @db.Date
  label            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  newsletterType NewsletterType @relation(fields: [newsletterTypeId], references: [id], onDelete: Cascade)

  @@index([organizationId, startDate, endDate])
  @@index([newsletterTypeId, startDate, endDate])
  @@map("newsletter_blocked_range")
  @@schema("public")
}

model NewsletterCampaign {
  id          String                   @id @default(cuid())
  typeId      String
  authorId    String?
  createdById String
  date        DateTime                 @db.Date
  campaignUrl String?
  status      NewsletterCampaignStatus @default(published)
  note        String?
  /// Wordle-Lösungswort für diese Ausgabe (genau 5 Buchstaben)
  wordleWord  String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  type      NewsletterType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  author    User?          @relation("NewsletterAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdBy User           @relation("NewsletterCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([typeId, date])
  @@index([authorId])
  @@index([date])
  @@map("newsletter_campaign")
  @@schema("public")
}

// ─── Ferienplan ────────────────────────────────────────────────

enum VacationStatus {
  pending
  approved
  rejected

  @@schema("public")
}

model VacationRequest {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  startDate      DateTime       @db.Date
  endDate        DateTime       @db.Date
  note           String?
  status         VacationStatus @default(pending)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("VacationRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("VacationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, startDate])
  @@index([organizationId, status])
  @@index([userId])
  @@map("vacation_request")
  @@schema("public")
}

// ─── Arbeitszeit ───────────────────────────────────────────────

enum TimeEntryType {
  work
  sick
  vacation
  holiday

  @@schema("public")
}

/// Ein Tageseintrag: Arbeit mit 1:n Zeitsegmenten (Arbeit/Pause), oder Abwesenheit
model TimeEntry {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  date           DateTime      @db.Date
  type           TimeEntryType @default(work)
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  segments     TimeSegment[]

  @@unique([organizationId, userId, date])
  @@index([userId, date])
  @@index([organizationId, date])
  @@map("time_entry")
  @@schema("public")
}

enum TimeSegmentType {
  work
  break

  @@schema("public")
}

/// Geschlossenes Intervall (Arbeit oder Pause) innerhalb eines Tageseintrags
model TimeSegment {
  id          String          @id @default(cuid())
  timeEntryId String
  type        TimeSegmentType @default(work)
  /// "HH:mm" Lokalzeit
  startTime   String
  /// "HH:mm" Lokalzeit (Pflicht — keine offenen Segmente)
  endTime     String
  sortOrder   Int             @default(0)

  timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  @@index([timeEntryId, sortOrder])
  @@map("time_segment")
  @@schema("public")
}

// ─── Wiki ──────────────────────────────────────────────────────

/// Wissensbasis: hierarchische Markdown-Seiten im Wiki-Space
model WikiPage {
  id             String   @id @default(cuid())
  organizationId String
  spaceId        String
  title          String
  slug           String
  body           String   @db.Text
  parentId       String?
  sortOrder      Int      @default(0)
  /// Pin — prominent in Sidebar / Wiki-Start
  pinned         Boolean  @default(false)
  createdById    String
  updatedById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space        Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parent       WikiPage?    @relation("WikiPageTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     WikiPage[]   @relation("WikiPageTree")
  createdBy    User         @relation("WikiPageCreator", fields: [createdById], references: [id], onDelete: Cascade)
  updatedBy    User         @relation("WikiPageUpdater", fields: [updatedById], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([spaceId, parentId, sortOrder])
  @@index([organizationId, pinned])
  @@index([parentId])
  @@map("wiki_page")
  @@schema("public")
}

// ─── Newsfeed / Quellen ────────────────────────────────────────

enum NewsItemStatus {
  neu
  interessant
  beobachten
  verworfen

  @@schema("public")
}

/// Eintrag aus lokalen Zürich-Quellen (RSS / Scrape / Amtsblatt)
model NewsItem {
  id             String         @id @default(cuid())
  organizationId String
  /// Stabiler Schlüssel: sourceKey::guid (unique pro Org)
  externalId     String
  source         String
  sourceLabel    String
  title          String
  link           String
  summary        String?        @db.Text
  publishedAt    DateTime?
  fetchedAt      DateTime
  status         NewsItemStatus @default(neu)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalId])
  @@index([organizationId, status])
  @@index([organizationId, source])
  @@index([organizationId, publishedAt])
  @@map("news_item")
  @@schema("public")
}

/// Instagram-Carousel (Arbeitstitel + Slide-JSON für den Editor)
model CarouselPost {
  id             String   @id @default(cuid())
  title          String
  slides         Json
  /// Original Tsüri-Artikel, falls aus URL importiert
  sourceUrl      String?
  sourcePreTitle String?
  sourceTitle    String?
  sourceLead     String?  @db.Text
  sourceBody     String?  @db.Text
  /// "standard" | "kolumne" | "interview" | "tsueritipp" | "6ibrief"
  format         String   @default("standard")
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy User @relation("CarouselPostCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@map("carousel_post")
  @@schema("public")
}

// ─── Direct-Sold Ads (intern) ──────────────────────────────────

enum CampaignStatus {
  ACTIVE
  PAUSED

  @@schema("public")
}

enum CreativeType {
  IMAGE
  VIDEO

  @@schema("public")
}

enum AdEventType {
  IMPRESSION
  CLICK

  @@schema("public")
}

/// Direct-Sold-Kampagne (intern verwaltet, ein Slot: article-top)
model Campaign {
  id              String         @id @default(cuid())
  name            String
  startDate       DateTime
  endDate         DateTime
  status          CampaignStatus @default(ACTIVE)
  /// Max. Impressions; null = unbegrenzt
  impressionLimit Int?
  creatives       Creative[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, startDate, endDate])
  @@map("campaign")
  @@schema("public")
}

model Creative {
  id         String       @id @default(cuid())
  campaignId String
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type       CreativeType
  /// Bild-URL oder Vimeo-Embed-URL
  mediaUrl   String
  /// Klick-Ziel
  targetUrl  String
  events     AdEvent[]
  createdAt  DateTime     @default(now())

  @@index([campaignId])
  @@map("creative")
  @@schema("public")
}

model AdEvent {
  id         String      @id @default(cuid())
  creativeId String
  creative   Creative    @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  type       AdEventType
  createdAt  DateTime    @default(now())

  @@index([creativeId, type])
  @@map("ad_event")
  @@schema("public")
}

// ─── Payrexx Abrechnung ───────────────────────────────────────

model PayrexxPayout {
  id             String   @id @default(cuid())
  organizationId String
  /// Stable key from import (filename / generated)
  uuid           String
  date           String
  currency       String   @default("CHF")
  /// vollständig | braucht Review
  status         String
  statement      String?
  payoutFee      Decimal  @default(0) @db.Decimal(14, 2)
  grandTotal     Decimal  @default(0) @db.Decimal(14, 2)
  unmappedCount  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        PayrexxPayoutLine[]

  @@unique([organizationId, uuid])
  @@index([organizationId, date])
  @@map("payrexx_payout")
  @@schema("public")
}

model PayrexxPayoutLine {
  id                String   @id @default(cuid())
  payoutId          String
  typ               String
  transactionId     String?
  date              String?
  time              String?
  amount            Decimal  @db.Decimal(14, 2)
  fees              Decimal  @db.Decimal(14, 2)
  total             Decimal  @db.Decimal(14, 2)
  currency          String?
  description       String?
  channel           String?
  paymentMethod     String?
  customer          String?
  externalReference String?
  instance          String?
  categoryKey       String?
  categorySource    String?
  createdAt         DateTime @default(now())

  payout PayrexxPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@index([payoutId, categoryKey])
  @@index([payoutId, channel])
  @@map("payrexx_payout_line")
  @@schema("public")
}

model PayrexxChannelRule {
  id             String   @id @default(cuid())
  organizationId String
  channel        String
  categoryKey    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, channel])
  @@map("payrexx_channel_rule")
  @@schema("public")
}

// ─── Member quotas (AI / RAG / image proxy) ────────────────────

enum MemberUsageKind {
  ai
  rag_search
  image_proxy

  @@schema("public")
}

/// Rolling-window usage for paid APIs (Claude, Voyage, image proxy)
model MemberUsage {
  id        String          @id @default(cuid())
  userId    String
  kind      MemberUsageKind
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("member_usage")
  @@schema("public")
}

// ─── DAM / Foto-Archiv ─────────────────────────────────────────

enum AssetStatus {
  staging
  published
  rejected
  archived

  @@schema("public")
}

enum RightsType {
  own
  provided
  free_use

  @@schema("public")
}

model UploadBatch {
  id         String   @id @default(cuid())
  uploadedBy String
  user       User     @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  credit     String
  createdAt  DateTime @default(now())
  assets     Asset[]

  @@index([uploadedBy])
  @@map("upload_batch")
  @@schema("public")
}

model Asset {
  id          String      @id @default(cuid())
  batchId     String
  batch       UploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sequence    Int
  fileName    String
  r2Key       String      @unique
  status      AssetStatus @default(staging)
  rating      Int?
  credit      String
  rightsType  RightsType
  altText     String?
  keywords    String[]    @default([])
  notes       String?
  mediagraphId String?     @unique
  importSource String?
  exif        Json?
  takenAt     DateTime?
  width       Int?
  height      Int?
  editParams  Json?
  uploadedBy  String
  uploader    User        @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  publishedAt DateTime?
  deletedAt   DateTime?
  deletedBy   String?
  deleter     User?       @relation("AssetDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  collections AssetCollection[]
  exports     ExportLog[]

  @@unique([batchId, sequence])
  @@index([status])
  @@index([uploadedBy])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@map("asset")
  @@schema("public")
}

model Collection {
  id         String            @id @default(cuid())
  name       String
  createdBy  String
  creator    User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  isPersonal Boolean           @default(true)
  mediagraphId String?         @unique
  createdAt  DateTime          @default(now())
  assets     AssetCollection[]

  @@index([createdBy])
  @@map("collection")
  @@schema("public")
}

model AssetCollection {
  assetId      String
  asset        Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([assetId, collectionId])
  @@index([collectionId])
  @@map("asset_collection")
  @@schema("public")
}

model ExportLog {
  id         String   @id @default(cuid())
  assetId    String?
  asset      Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  exportedBy String
  exporter   User     @relation(fields: [exportedBy], references: [id], onDelete: Restrict)
  exportedAt DateTime @default(now())
  targetUrl  String?

  @@index([assetId])
  @@index([exportedBy])
  @@map("export_log")
  @@schema("public")
}

model DamArchiveReview {
  id             String   @id @default(cuid())
  reviewedUntil  DateTime
  completedAt    DateTime @default(now())
  completedBy    String?
  completer      User?    @relation(fields: [completedBy], references: [id], onDelete: SetNull)
  remainingCount Int

  @@index([completedAt])
  @@map("dam_archive_review")
  @@schema("public")
}

// ─── RAG / pgvector (schema: rag) ──────────────────────────────
// Embeddings: Voyage voyage-4, 1024 dims. Vector ops via $queryRaw only.

model RagArticle {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wepublishId  String    @unique @map("wepublish_id")
  slug         String?
  url          String?
  title        String?
  lead         String?
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(6)
  authors      Json?     @db.JsonB
  tags         Json?     @db.JsonB
  imageUrl     String?   @map("image_url")
  rawWordCount Int?      @map("raw_word_count")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  chunks RagArticleChunk[]

  @@map("articles")
  @@schema("rag")
}

model RagArticleChunk {
  id           String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId    String                       @map("article_id") @db.Uuid
  chunkIndex   Int                          @map("chunk_index")
  chunkText    String                       @map("chunk_text")
  charCount    Int?                         @map("char_count")
  wordCount    Int?                         @map("word_count")
  /// Voyage embedding; read/write via prisma.$queryRaw / $executeRaw
  embeddingVec Unsupported("vector(1024)")? @map("embedding_vec")
  updatedAt    DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  article RagArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, chunkIndex])
  @@index([articleId])
  @@map("article_chunks")
  @@schema("rag")
}
