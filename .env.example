# Database (local Prisma Postgres via `npx prisma dev --name teamhub-v2`)
DATABASE_URL="postgres://postgres:postgres@localhost:51221/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

# Better Auth
BETTER_AUTH_SECRET="dev-secret-change-me-in-production-teamhub-2026"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Slack Incoming Webhook (optional — Kochplan channel digests)
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Bootstrap (seed)
SEED_ADMIN_EMAIL="admin@team.local"
SEED_ADMIN_PASSWORD="admin1234"
SEED_ADMIN_NAME="Admin"
SEED_ORG_NAME="Unser Team"
SEED_ORG_SLUG="team"
