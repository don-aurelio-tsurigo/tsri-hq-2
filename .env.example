# Database (local Prisma Postgres via `npx prisma dev --name teamhub-v2`)
DATABASE_URL="postgres://postgres:postgres@localhost:51221/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

# Better Auth
BETTER_AUTH_SECRET="dev-secret-change-me-in-production-teamhub-2026"
# Public URL (custom domain). Login links and session cookies use this.
# On Render set this to https://tsri-hub.online — not the *.onrender.com URL.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional: comma-separated extra origins (e.g. the Render hostname)
# ADDITIONAL_TRUSTED_ORIGINS="https://tsri-hq-2.onrender.com"
# Optional: extra CORS origins for external Ad embed (tsri.ch is included by default)
# ADS_CORS_ORIGINS="https://staging.tsri.ch"

# Transactional email (login links). In production both are required.
# Verify the sending domain in Resend first.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Tsüri HQ <noreply@deine-domain.ch>"

# Optional Slack Incoming Webhook fallback (per-notification URLs in Admin UI win)
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Carousel article import + DAM WePublish export (Tsüri / we.publish + Anthropic)
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-5"
# WEPUBLISH_API_URL="https://api-tsri.wepublish.cloud"
# WEPUBLISH_API_TOKEN=""

# RAG semantic search (Voyage + pgvector on schema rag)
# VOYAGE_API_KEY="pa-..."
# VOYAGE_MODEL="voyage-4"
# Optional: separate DB for rag.* (e.g. Render) while DATABASE_URL stays local
# RAG_DATABASE_URL="postgresql://…@….frankfurt-postgres.render.com/tsri_hq_db?sslmode=require"
# In-process daily sync (WePublish → embed → upsert rag.*). Default on when VOYAGE_API_KEY is set.
# RAG_SYNC_ENABLED="true"
# RAG_SYNC_LIMIT="100"
# RAG_SYNC_PAGE_SIZE="25"
# RAG_SYNC_EMBED_BATCH="32"

# Per-member rolling quotas (defaults: 60 min window)
# MEMBER_QUOTA_WINDOW_MINUTES="60"
# MEMBER_QUOTA_AI_MAX="30"
# MEMBER_QUOTA_RAG_MAX="30"
# MEMBER_QUOTA_PROXY_MAX="80"

# Cloudflare R2 (S3-compatible, DAM uploads)
# Bucket CORS must allow PUT from NEXT_PUBLIC_APP_URL (and localhost in dev).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Optional override; default: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=""

# Mediagraph → DAM import (scripts/mediagraph-import.ts)
# MEDIAGRAPH_TOKEN=""
# MEDIAGRAPH_ORG_ID=""
# MEDIAGRAPH_UPLOADER_USER_ID=""
# MEDIAGRAPH_UPLOADER_EMAIL="elio@…"
# Optional Rights-Package-IDs (comma-separated) after the --test probe
# MEDIAGRAPH_RIGHTS_OWN_IDS=""
# MEDIAGRAPH_RIGHTS_PROVIDED_IDS=""
# MEDIAGRAPH_RIGHTS_FREE_USE_IDS=""
# MEDIAGRAPH_REPORT_DIR="./tmp/mediagraph-import"
# MEDIAGRAPH_CONCURRENCY="3"

# Bootstrap (seed)
SEED_ADMIN_EMAIL="admin@team.local"
SEED_ADMIN_PASSWORD="admin1234"
SEED_ADMIN_NAME="Admin Team"
# Optional; otherwise SEED_ADMIN_NAME is split into first / last.
# SEED_ADMIN_FIRST_NAME="Admin"
# SEED_ADMIN_LAST_NAME="Team"
SEED_ORG_NAME="Unser Team"
SEED_ORG_SLUG="team"
