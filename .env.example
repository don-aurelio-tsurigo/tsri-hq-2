# Database (local Prisma Postgres via `npx prisma dev --name teamhub-v2`)
DATABASE_URL="postgres://postgres:postgres@localhost:51221/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

# Better Auth
BETTER_AUTH_SECRET="dev-secret-change-me-in-production-teamhub-2026"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Slack Incoming Webhook fallback (per-notification URLs in Admin UI win)
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Carousel article import (Tsüri / we.publish + Anthropic)
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-5"
# WEPUBLISH_API_URL="https://api-tsri.wepublish.cloud"

# RAG semantic search (Voyage + pgvector on schema rag)
# VOYAGE_API_KEY="pa-..."
# VOYAGE_MODEL="voyage-4"
# Optional: separate DB for rag.* (e.g. Render) while DATABASE_URL stays local
# RAG_DATABASE_URL="postgresql://…@….frankfurt-postgres.render.com/tsri_hq_db?sslmode=require"
# In-process daily sync (WePublish → embed → upsert rag.*). Default on when VOYAGE_API_KEY is set.
# RAG_SYNC_ENABLED="true"
# RAG_SYNC_LIMIT="100"
# RAG_SYNC_PAGE_SIZE="25"
# RAG_SYNC_EMBED_BATCH="32"

# Bootstrap (seed)
SEED_ADMIN_EMAIL="admin@team.local"
SEED_ADMIN_PASSWORD="admin1234"
SEED_ADMIN_NAME="Admin"
SEED_ORG_NAME="Unser Team"
SEED_ORG_SLUG="team"
